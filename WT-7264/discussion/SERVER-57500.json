stomfield_15850":"{}","customfield_13552":null,"aggregateprogress":{"progress":0,"total":0},"customfield_10555":5.0,"customfield_10557":["com.atlassian.greenhopper.service.sprint.Sprint@763ad6bc[activatedDate=2024-04-16T04:12:09.413Z,autoStartStop=false,completeDate=2024-04-30T05:19:35.664Z,endDate=2024-04-30T09:24:00.000Z,goal=,id=8408,incompleteIssuesDestinationId=<null>,name=Nick - 2024-04-30,rapidViewId=467,sequence=8340,startDate=2024-04-16T09:24:00.000Z,state=CLOSED,synced=false]"],"customfield_10558":"9223372036854775807","customfield_28352":"2024-04-17T02:00:12.001+0000","customfield_24550":null,"progress":{"progress":0,"total":0},"votes":{"self":"https://jira.mongodb.org/rest/api/2/issue/WT-7653/votes","votes":0,"hasVoted":false},"worklog":{"startAt":0,"maxResults":20,"total":0,"worklogs":[]},"customfield_26854":null,"archivedby":null,"customfield_20359":null,"customfield_26853":null,"customfield_26856":null,"customfield_26855":null,"issuetype":{"self":"https://jira.mongodb.org/rest/api/2/issuetype/1","id":"1","description":"A problem which impairs or prevents the functions of the product.","iconUrl":"https://jira.mongodb.org/secure/viewavatar?size=xsmall&avatarId=14703&avatarType=issuetype","name":"Bug","subtask":false,"avatarId":14703},"customfield_18950":null,"customfield_20078":null,"customfield_17465":null,"customfield_14352":null,"timespent":null,"customfield_14350":"1|hzjp3b:","customfield_14355":null,"customfield_18955":null,"customfield_12450":null,"project":{"self":"https://jira.mongodb.org/rest/api/2/project/12782","id":"12782","key":"WT","name":"WiredTiger","projectTypeKey":"software","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/projectavatar?pid=12782&avatarId=15310","24x24":"https://jira.mongodb.org/secure/projectavatar?size=small&pid=12782&avatarId=15310","16x16":"https://jira.mongodb.org/secure/projectavatar?size=xsmall&pid=12782&avatarId=15310","32x32":"https://jira.mongodb.org/secure/projectavatar?size=medium&pid=12782&avatarId=15310"},"projectCategory":{"self":"https://jira.mongodb.org/rest/api/2/projectCategory/10000","id":"10000","description":"","name":"Server"}},"customfield_17467":null,"customfield_10550":null,"customfield_17466":null,"customfield_18555":1.0,"customfield_18951":null,"aggregatetimespent":null,"customfield_18952":null,"customfield_10553":null,"customfield_14995":null,"customfield_10554":null,"customfield_18954":null,"resolutiondate":"2024-04-17T02:49:39.000+0000","workratio":-1,"customfield_23474":null,"customfield_17450":null,"watches":{"self":"https://jira.mongodb.org/rest/api/2/issue/WT-7653/watchers","watchCount":13,"isWatching":false},"customfield_17052":null,"customfield_17051":null,"created":"2021-06-07T16:41:21.000+0000","customfield_19353":null,"customfield_29060":null,"customfield_28251":22176.1364975,"customfield_28651":"","customfield_24851":"","customfield_17050":null,"customfield_24455":null,"customfield_24456":null,"updated":"2024-05-27T04:23:36.000+0000","customfield_14050":null,"customfield_18254":"","customfield_14051":null,"customfield_14450":null,"customfield_14451":null,"timeoriginalestimate":null,"customfield_12550":"2|hr1oxe:00000000241","description":"This is being split off from SERVER-56509, which made a change that improved a performance regression on unique indexes, however, update performance is still an order of magnitude worse on unique indexes than non-unique indexes. This is reproducible back to 4.2.\r\n\r\nQuoting myself:\r\n{quote}I wrote a reproducer (attached as \"SERVER-56509.js\") for the multi-update problem, and the \"prefix_key\" change does not appear to have completely resolved the regression related to updates on unique indexes. Locally, a multi-update on a non-unique index field for 10K docs took about 250ms. The same update on a unique field took about 15s without the \"prefix_key\" change and about 8s with the \"prefix_key\" change.\r\n{quote}\r\n{quote}I also discovered that the regression only exists if a unique field is updated to a value that sorts before the original key. For example, updating an index field from \"ZZZ\" to \"AAA\" triggers the regression, but updating the same field from \"AAA\" to \"ZZZ\" does not. I assume this is because of the way MongoDB constructs KeyStrings for seeking when calling _keyExists.\r\n{quote}","customfield_14851":null,"customfield_14452":null,"customfield_12551":[],"customfield_11861":null,"timetracking":{},"customfield_17959":null,"customfield_17958":null,"customfield_29350":null,"attachment":[{"self":"https://jira.mongodb.org/rest/api/2/attachment/319116","id":"319116","filename":"SERVER-56509.js","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=louis.williams%40mongodb.com","name":"louis.williams@mongodb.com","key":"louis.williams","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=louis.williams&avatarId=23008","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=louis.williams&avatarId=23008","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=louis.williams&avatarId=23008","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=louis.williams&avatarId=23008"},"displayName":"Louis Williams","active":true,"timeZone":"America/New_York"},"created":"2021-06-07T16:36:32.000+0000","size":1317,"mimeType":"text/javascript","content":"https://jira.mongodb.org/secure/attachment/319116/SERVER-56509.js"}],"customfield_25156":null,"summary":"Inconsistent update performance on unique indexes","customfield_20288":null,"customfield_20289":null,"customfield_23812":null,"customfield_20287":null,"customfield_18361":null,"customfield_15650":null,"customfield_16463":null,"customfield_18362":null,"customfield_11450":null,"customfield_16467":null,"customfield_11452":null,"customfield_16466":null,"customfield_11451":null,"customfield_16465":null,"customfield_11453":null,"environment":null,"customfield_25161":"No linked dependency.","duedate":null,"customfield_19050":null,"comment":{"comments":[{"self":"https://jira.mongodb.org/rest/api/2/issue/1770796/comment/4682871","id":"4682871","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=donald.anderson%40mongodb.com","name":"donald.anderson@mongodb.com","key":"donald.anderson","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=donald.anderson&avatarId=15312","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=donald.anderson&avatarId=15312","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=donald.anderson&avatarId=15312","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=donald.anderson&avatarId=15312"},"displayName":"Donald Anderson","active":true,"timeZone":"America/Havana"},"body":"Priority assessment: Leaving this at P3.  We should really understand why there is a performance gap here.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=donald.anderson%40mongodb.com","name":"donald.anderson@mongodb.com","key":"donald.anderson","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=donald.anderson&avatarId=15312","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=donald.anderson&avatarId=15312","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=donald.anderson&avatarId=15312","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=donald.anderson&avatarId=15312"},"displayName":"Donald Anderson","active":true,"timeZone":"America/Havana"},"created":"2022-07-15T17:26:21.000+0000","updated":"2022-07-15T17:26:21.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/1770796/comment/6272050","id":"6272050","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=chenhao.qu%40mongodb.com","name":"chenhao.qu@mongodb.com","key":"chenhao.qu","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17815","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17815","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17815","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17815"},"displayName":"Chenhao Qu","active":true,"timeZone":"UTC"},"body":"I reran the reproducer on the latest master code. The performance gap has disappeared.\r\n\r\n\r\n{code:java}\r\n[js_test:SERVER-56509] starting bulk load on nonUnique\r\n[js_test:SERVER-56509] inserted 10000\r\n[js_test:SERVER-56509] bulk load on nonUnique: 167ms\r\n[js_test:SERVER-56509] starting update on nonUnique\r\n.....\r\n[js_test:SERVER-56509] update on nonUnique: 420ms\r\n[js_test:SERVER-56509] starting bulk load on unique\r\n[js_test:SERVER-56509] inserted 10000\r\n[js_test:SERVER-56509] bulk load on unique: 211ms\r\n[js_test:SERVER-56509] starting update on unique\r\n.....\r\n[js_test:SERVER-56509] update on unique: 484ms\r\n{code}\r\n\r\nI think the performance improvement mainly can be attributed to MongoDB moving away from using search_near on unique indexes. Instead, we now use a single next or prev call on the bounded cursor to locate to the correct key, which is much more efficient. Close this ticket as the gap has gone away.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=chenhao.qu%40mongodb.com","name":"chenhao.qu@mongodb.com","key":"chenhao.qu","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17815","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17815","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17815","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17815"},"displayName":"Chenhao Qu","active":true,"timeZone":"UTC"},"created":"2024-04-17T02:48:20.000+0000","updated":"2024-04-17T02:52:36.000+0000"}],"maxResults":1000,"total":2,"startAt":0},"customfield_20279":null},"renderedFields":null}