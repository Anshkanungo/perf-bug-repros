000_*|*_12452_*:*_2_*:*_1674986000_*|*_10038_*:*_3_*:*_11569238000","customfield_10054":null,"customfield_10055":"2022-07-06T14:03:35.000+0000","customfield_10056":"suganthi.mani@mongodb.com(suganthi.mani)","customfield_10057":"true","customfield_25350":null,"customfield_25351":null,"customfield_25352":null,"customfield_26568":197.0,"subtasks":[],"customfield_21052":null,"customfield_15851":null,"customfield_13550":null,"customfield_17479":null,"reporter":{"self":"https://jira.mongodb.org/rest/api/2/user?username=deepti.hasija%40mongodb.com","name":"deepti.hasija@mongodb.com","key":"JIRAUSER1254368","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=JIRAUSER1254368&avatarId=32589","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=JIRAUSER1254368&avatarId=32589","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=JIRAUSER1254368&avatarId=32589","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=JIRAUSER1254368&avatarId=32589"},"displayName":"Deepti Hasija","active":false,"timeZone":"UTC"},"customfield_13552":null,"customfield_15850":"{}","customfield_10166":null,"progress":{"progress":0,"total":0},"votes":{"self":"https://jira.mongodb.org/rest/api/2/issue/SERVER-65527/votes","votes":0,"hasVoted":false},"worklog":{"startAt":0,"maxResults":20,"total":0,"worklogs":[]},"archivedby":null,"issuetype":{"self":"https://jira.mongodb.org/rest/api/2/issuetype/4","id":"4","description":"An improvement or enhancement to an existing feature or task.","iconUrl":"https://jira.mongodb.org/secure/viewavatar?size=xsmall&avatarId=14710&avatarType=issuetype","name":"Improvement","subtask":false,"avatarId":14710},"customfield_20078":null,"customfield_17465":null,"customfield_22251":null,"customfield_12451":null,"customfield_22250":{"self":"https://jira.mongodb.org/rest/api/2/customFieldOption/23343","value":"Not Needed","id":"23343","disabled":false},"customfield_12450":null,"project":{"self":"https://jira.mongodb.org/rest/api/2/project/10000","id":"10000","key":"SERVER","name":"Core Server","projectTypeKey":"software","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/projectavatar?pid=10000&avatarId=13900","24x24":"https://jira.mongodb.org/secure/projectavatar?size=small&pid=10000&avatarId=13900","16x16":"https://jira.mongodb.org/secure/projectavatar?size=xsmall&pid=10000&avatarId=13900","32x32":"https://jira.mongodb.org/secure/projectavatar?size=medium&pid=10000&avatarId=13900"},"projectCategory":{"self":"https://jira.mongodb.org/rest/api/2/projectCategory/10000","id":"10000","description":"","name":"Server"}},"customfield_17467":null,"customfield_17466":null,"customfield_18555":4.0,"customfield_14995":null,"resolutiondate":"2022-10-26T23:20:14.000+0000","customfield_17450":null,"watches":{"self":"https://jira.mongodb.org/rest/api/2/issue/SERVER-65527/watchers","watchCount":9,"isWatching":false},"customfield_24967":null,"customfield_29060":null,"customfield_28651":"","customfield_24851":"","updated":"2024-06-27T15:08:55.000+0000","customfield_14050":null,"customfield_14051":null,"timeoriginalestimate":null,"customfield_12550":"2|i0cw0o:","description":"Unique index duplicate key check searches for the key's existence before insertion into the index. {{search_near}} cursor API is used for the purpose. With durable history, the search through a table with a lot of deleted content became more expensive hence causing regression with insertion into the unique indexes. A prefix-search API was added that would cause {{search_near}} to early exit if the search was past the prefix. The prefix-search is being replaced by a feature to configure bounds on a cursor.\r\n\r\nAn existing prefix search can be replaced with a cursor bound on the prefix. This ticket will do so for the above-mentioned unique index usage in the server.\r\n\r\n","customfield_10011":{"self":"https://jira.mongodb.org/rest/api/2/customFieldOption/10038","value":"Fully Compatible","id":"10038","disabled":false},"customfield_12551":[],"customfield_14852":null,"timetracking":{},"customfield_25156":null,"summary":"Use range bounded cursors in place of prefix search_near on unique indexes","customfield_20288":null,"customfield_20289":null,"customfield_20287":null,"customfield_16463":null,"customfield_11450":null,"customfield_16467":null,"customfield_14166":null,"customfield_16466":null,"customfield_11452":null,"customfield_10000":null,"customfield_16465":null,"customfield_11451":null,"customfield_11453":null,"environment":null,"customfield_25161":"<div><a href='https://jira.mongodb.org/browse/WT-9324' style='text-decoration: line-through;'>WT-9324 - Add additional logic to cursor->search_near to handle range bounds.</a><br><strong>Status:</strong> Closed<br><strong>Due Date:</strong> Not Set<br><strong>Assignee:</strong> Luke Pearson<br><br><strong>Last Comment:</strong> Githook User - Over 52 months ago<br><div>Author:{'name': 'Siddhartha Mahajan', 'email': 'siddhartha.mahajan8899@mongodb.com'}\nMessage: Import wiredtiger: f425db172e646d4e6850471607dc59883212a5e4 from branch mongodb-master\n\nref: 2c40d4eed4..f425db172e\nfor: 6.1.0-rc0\n\nWT-9324 Updating cursor search near logic to handle range bounds for row-store. (#8091)\nBranch: master\nhttps://github.com/mongodb/mongo/commit/ed432b5394d8762429718d7d51c37c663f004f8b</div><br><hr/><div><a href='https://jira.mongodb.org/browse/HELP-60583' style='text-decoration: line-through;'>HELP-60583 - Secondary taking more than one hour to apply replication batches</a><br><strong>Status:</strong> Closed<br><strong>Due Date:</strong> Not Set<br><strong>Assigned Teams:</strong> [Storage Execution]<br><strong>Assignee:</strong> Vishnu Kaushik<br><br><strong>Last Comment:</strong> Vishnu Kaushik - Over 27 months ago<br><div>There was a performance bug that caused secondaries to do more work than required when applying oplog entries with a unique index.</div><br><hr/>","duedate":null,"customfield_19050":null,"comment":{"comments":[{"self":"https://jira.mongodb.org/rest/api/2/issue/2023847/comment/4660220","id":"4660220","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=yujin.kang%40mongodb.com","name":"yujin.kang@mongodb.com","key":"JIRAUSER1265133","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17825","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17825","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17825","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17825"},"displayName":"Yujin Kang Park","active":true,"timeZone":"UTC"},"body":"Depends on WT-9324 which makes search_near use the cursor bounds. ","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=yujin.kang%40mongodb.com","name":"yujin.kang@mongodb.com","key":"JIRAUSER1265133","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17825","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17825","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17825","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17825"},"displayName":"Yujin Kang Park","active":true,"timeZone":"UTC"},"created":"2022-07-06T14:03:35.000+0000","updated":"2022-07-06T14:03:35.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/2023847/comment/4746255","id":"4746255","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=sulabh.mahajan%40mongodb.com","name":"sulabh.mahajan@mongodb.com","key":"sulabh.mahajan","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=sulabh.mahajan&avatarId=17666","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=sulabh.mahajan&avatarId=17666","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=sulabh.mahajan&avatarId=17666","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=sulabh.mahajan&avatarId=17666"},"displayName":"Sulabh Mahajan","active":true,"timeZone":"Europe/Madrid"},"body":"Here is the update from the work so far. I have tried to follow 2/3 approaches:\r\n\r\n* Bound the cursor to {{lower=prefix-key,inclusive}} and to {{upper=prefix-key-last-byte-incremented,exclusive}}. Do a {{search_near}} as before.\r\n* Bound the cursor to {{lower=prefix-key,inclusive}} and put no upper bound. Instead of a {{search_near}}, do a next and let the cursor bound only return keys that match the prefix.\r\n* Bound the cursor to {{lower=prefix-key,inclusive}} and to {{upper=prefix-key-last-byte-incremented,exclusive}}. Instead of a {{search_near}}, do a next and let the cursor bound only return keys that match the prefix.\r\n\r\nI have run MongoDB patch tests and all approaches seem to work and not produce any immediately obvious bugs. I am still using the repro script from SERVER-56509 to test the performance locally. All approaches improve the performance compared to not having any sort of prefix search. Having an upper bound seems to be necessary for now - even when doing {{next}} instead of {{search_near}}. I am not sure why, I expected we wont be needing upper bound if we use {{next}} call. The best performance comes from having both the bounds and doing a {{next}} instead of {{search_near}}.\r\n\r\nThe next steps:\r\n* Understand the results - why not setting an upper bound and doing a next() is not as performant as setting an upper bound.\r\n* Run more conclusive performance testing\r\n* Discuss the results with the execution and WiredTiger team to decide which approach to follow. A similar approach could be used in other places in the code, so a discussion would help to generalise the approach.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=sulabh.mahajan%40mongodb.com","name":"sulabh.mahajan@mongodb.com","key":"sulabh.mahajan","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=sulabh.mahajan&avatarId=17666","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=sulabh.mahajan&avatarId=17666","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=sulabh.mahajan&avatarId=17666","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=sulabh.mahajan&avatarId=17666"},"displayName":"Sulabh Mahajan","active":true,"timeZone":"Europe/Madrid"},"created":"2022-08-12T09:04:05.000+0000","updated":"2022-08-12T09:04:05.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/2023847/comment/4767264","id":"4767264","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=sulabh.mahajan%40mongodb.com","name":"sulabh.mahajan@mongodb.com","key":"sulabh.mahajan","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=sulabh.mahajan&avatarId=17666","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=sulabh.mahajan&avatarId=17666","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=sulabh.mahajan&avatarId=17666","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=sulabh.mahajan&avatarId=17666"},"displayName":"Sulabh Mahajan","active":true,"timeZone":"Europe/Madrid"},"body":"I scaled the repro up by a factor of 10 to get more input into performance differences, here is the time taken by the unique index updates:\r\n\r\n||Version||Time taken (ms)||\r\n|Master|4609|\r\n|Master without prefix search|332583|\r\n|Lower-and-upper-bounds-search-near|5161|\r\n|Lower-and-upper-bounds-next|5043|\r\n|Lower-bound-next|304351|\r\n\r\nI suspect that the versions where we set both the bounds would have been faster than the master if we would not been making a separate copy for the upper bound (prefix key's last byte incremented).\r\n!master-search-next.png|width=100%!\r\nnext = both upper and lower bounds then next() call to find the record\r\nsearch-near = both upper and lower bounds then search_near() call to find the record\r\nmaster = prefix search\r\n\r\n\r\nThe part that is unexpected is the version where we set the lower bound and follow with a next (I think it is the same for search-near) has to skip through a lot of records for some reason. This version is almost as inefficient as not having any bounds or prefix search:\r\n!lower-bound-inefficient.png|width=100%! \r\n\r\nlower-bound-next = Lower bound only then next() call to find the record\r\nmaster-prefix-off = search-near with no bounds and no prefix search.\r\n","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=sulabh.mahajan%40mongodb.com","name":"sulabh.mahajan@mongodb.com","key":"sulabh.mahajan","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=sulabh.mahajan&avatarId=17666","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=sulabh.mahajan&avatarId=17666","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=sulabh.mahajan&avatarId=17666","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=sulabh.mahajan&avatarId=17666"},"displayName":"Sulabh Mahajan","active":true,"timeZone":"Europe/Madrid"},"created":"2022-08-22T14:54:45.000+0000","updated":"2022-08-22T15:17:52.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/2023847/comment/4769195","id":"4769195","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=jie.chen%40mongodb.com","name":"jie.chen@mongodb.com","key":"jie.chen","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17813","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17813","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17813","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17813"},"displayName":"Jie Chen","active":true,"timeZone":"Australia/Sydney"},"body":"From my understanding, I can give a go at explaining the differences in performance, especially why lower bound have little to no performance increase compared to a regular search near.\r\n\r\n\r\n-When the user only sets the lower bound, and performs a next(). WiredTiger internally positions the cursor on the lower bound, and does this through performing a search near on the lower bound. In the case that the data range has lots of invisible records between the lower bound and the first visible key, the bounded cursor functionality has would not early exit in this case because there are no upper bounds set. Thus doing so, it can potentially act exactly how a regular search near would work and explain the similar performance as a regular search near.-\r\n\r\n-In the case that we do set the lower bound and upper bound, and if WT performs a next() it would internally perform search near the cursor on the lower, but be able to early exit on the upper bound. Which can possibly explain the big difference in performance here.-\r\n\r\n-It would be interesting to check the performance of only setting the upper bound and performing a prev(). I would imagine it would behave the same since it also does a search near in this case. Something more interesting would be setting the upper bound and performing a search near as well.-\r\n\r\n*Edit:* When a lower bound is set, WT would internally call cursor_row_search() which attempts to position the cursor closest to the key (irrelevant of visibility). Furthermore the range cursor will check the visibility of the key. If the current position is not visible, we will perform a next() to find a visible key. My assumption is that the next() is taking a long time The range cursor project will look into this.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=jie.chen%40mongodb.com","name":"jie.chen@mongodb.com","key":"jie.chen","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17813","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17813","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17813","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17813"},"displayName":"Jie Chen","active":true,"timeZone":"Australia/Sydney"},"created":"2022-08-23T03:22:24.000+0000","updated":"2022-08-23T22:58:33.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/2023847/comment/4775793","id":"4775793","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=sulabh.mahajan%40mongodb.com","name":"sulabh.mahajan@mongodb.com","key":"sulabh.mahajan","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=sulabh.mahajan&avatarId=17666","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=sulabh.mahajan&avatarId=17666","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=sulabh.mahajan&avatarId=17666","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=sulabh.mahajan&avatarId=17666"},"displayName":"Sulabh Mahajan","active":true,"timeZone":"Europe/Madrid"},"body":"We have decided to put down this ticket for more time. We want to get feedback from bounded cursors on SERVER-65528 first as that seems to be the use case that will directly benefit from bounding the cursors.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=sulabh.mahajan%40mongodb.com","name":"sulabh.mahajan@mongodb.com","key":"sulabh.mahajan","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=sulabh.mahajan&avatarId=17666","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=sulabh.mahajan&avatarId=17666","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=sulabh.mahajan&avatarId=17666","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=sulabh.mahajan&avatarId=17666"},"displayName":"Sulabh Mahajan","active":true,"timeZone":"Europe/Madrid"},"created":"2022-08-25T08:08:44.000+0000","updated":"2022-08-25T08:08:44.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/2023847/comment/4930423","id":"4930423","author":{"self":"http