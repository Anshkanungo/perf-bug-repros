{"expand":"renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations","id":"2023847","self":"https://jira.mongodb.org/rest/api/2/issue/2023847","key":"SERVER-65527","fields":{"customfield_20550":null,"customfield_23823":null,"resolution":{"self":"https://jira.mongodb.org/rest/api/2/resolution/13201","id":"13201","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_18358":null,"customfield_18359":null,"customfield_26661":null,"customfield_24367":null,"lastViewed":null,"customfield_13450":null,"customfield_11151":"Wed Oct 26 22:53:49 UTC 2022","labels":[],"customfield_24370":null,"aggregatetimeoriginalestimate":null,"customfield_10857":"SPM-2317","customfield_24250":null,"issuelinks":[{"id":"1267685","self":"https://jira.mongodb.org/rest/api/2/issueLink/1267685","outwardIssue":{"id":"2046957","key":"WT-9324","self":"https://jira.mongodb.org/rest/api/2/issue/2046957","fields":{"summary":"Add additional logic to cursor->search_near to handle range bounds.","status":{"self":"https://jira.mongodb.org/rest/api/2/status/6","description":"The issue is considered finished, the resolution is correct. Issues which are closed can be reopened.","iconUrl":"https://jira.mongodb.org/images/icons/statuses/closed.png","name":"Closed","id":"6","statusCategory":{"self":"https://jira.mongodb.org/rest/api/2/statuscategory/3","id":3,"key":"done","colorName":"success","name":"Done"}},"priority":{"self":"https://jira.mongodb.org/rest/api/2/priority/3","iconUrl":"https://jira.mongodb.org/images/icons/priorities/major.svg","name":"Major - P3","id":"3"},"issuetype":{"self":"https://jira.mongodb.org/rest/api/2/issuetype/2","id":"2","description":"A new feature of the product, which has yet to be developed.","iconUrl":"https://jira.mongodb.org/secure/viewavatar?size=xsmall&avatarId=14711&avatarType=issuetype","name":"New Feature","subtask":false,"avatarId":14711}}},"type":{"id":"10011","name":"Depends","inward":"is depende