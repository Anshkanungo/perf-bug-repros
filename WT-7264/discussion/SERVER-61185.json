?ownerId=louis.williams&avatarId=23008","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=louis.williams&avatarId=23008","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=louis.williams&avatarId=23008","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=louis.williams&avatarId=23008"},"displayName":"Louis Williams","active":true,"timeZone":"America/New_York"},"body":"[~alex.podelko], the re-enabled prefix_key feature includes correctness fixes from WT-7912. [~monica.ng], [~chenhao.qu], would either of you expect WT-7912 have different performance characteristics as compared to the original implementation, WT-7264?","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=louis.williams%40mongodb.com","name":"louis.williams@mongodb.com","key":"louis.williams","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=louis.williams&avatarId=23008","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=louis.williams&avatarId=23008","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=louis.williams&avatarId=23008","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=louis.williams&avatarId=23008"},"displayName":"Louis Williams","active":true,"timeZone":"America/New_York"},"created":"2022-01-12T08:47:13.000+0000","updated":"2022-01-12T08:47:13.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/1915961/comment/4287582","id":"4287582","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=chenhao.qu%40mongodb.com","name":"chenhao.qu@mongodb.com","key":"chenhao.qu","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17815","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17815","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17815","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17815"},"displayName":"Chenhao Qu","active":true,"timeZone":"UTC"},"body":"[~louis.williams] I expect no change for the performance.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=chenhao.qu%40mongodb.com","name":"chenhao.qu@mongodb.com","key":"chenhao.qu","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17815","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17815","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17815","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17815"},"displayName":"Chenhao Qu","active":true,"timeZone":"UTC"},"created":"2022-01-12T08:51:30.000+0000","updated":"2022-01-12T08:51:30.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/1915961/comment/4289573","id":"4289573","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=chenhao.qu%40mongodb.com","name":"chenhao.qu@mongodb.com","key":"chenhao.qu","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17815","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17815","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17815","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17815"},"displayName":"Chenhao Qu","active":true,"timeZone":"UTC"},"body":"[~monica.ng] [~etienne.petrel] [~jie.chen] [~luke.pearson] Do you guys expect WT-7912 to have a performance impact? [~alex.podelko] If there is a regression, please create a wiredtiger ticket and we will look into it.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=chenhao.qu%40mongodb.com","name":"chenhao.qu@mongodb.com","key":"chenhao.qu","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=17815","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=17815","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=17815","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=17815"},"displayName":"Chenhao Qu","active":true,"timeZone":"UTC"},"created":"2022-01-12T21:55:47.000+0000","updated":"2022-01-12T21:55:47.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/1915961/comment/4289736","id":"4289736","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=monica.ng%40mongodb.com","name":"monica.ng@mongodb.com","key":"JIRAUSER1257876","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=JIRAUSER1257876&avatarId=28534","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=JIRAUSER1257876&avatarId=28534","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=JIRAUSER1257876&avatarId=28534","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=JIRAUSER1257876&avatarId=28534"},"displayName":"Monica Ng","active":true,"timeZone":"Australia/Sydney"},"body":"I don't expect it to have a performance impact but I agree with Chenhao, if there is a regression we can have a closer look into it.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=monica.ng%40mongodb.com","name":"monica.ng@mongodb.com","key":"JIRAUSER1257876","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=JIRAUSER1257876&avatarId=28534","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=JIRAUSER1257876&avatarId=28534","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=JIRAUSER1257876&avatarId=28534","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=JIRAUSER1257876&avatarId=28534"},"displayName":"Monica Ng","active":true,"timeZone":"Australia/Sydney"},"created":"2022-01-12T23:03:00.000+0000","updated":"2022-01-12T23:03:00.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/1915961/comment/4289749","id":"4289749","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=alex.podelko%40mongodb.com","name":"alex.podelko@mongodb.com","key":"JIRAUSER1257325","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=JIRAUSER1257325&avatarId=28409","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=JIRAUSER1257325&avatarId=28409","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=JIRAUSER1257325&avatarId=28409","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=JIRAUSER1257325&avatarId=28409"},"displayName":"Alex Podelko","active":false,"timeZone":"UTC"},"body":"[~monica.ng] I am not aware about a regression - but that fix was supposed to fix multiple regressions:  BF-22130 BF-23346  BF-22529. Doesn't look like it did. [~chenhao.qu] [~etienne.petrel] [~luke.pearson] [~jim.oleary]","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=alex.podelko%40mongodb.com","name":"alex.podelko@mongodb.com","key":"JIRAUSER1257325","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=JIRAUSER1257325&avatarId=28409","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=JIRAUSER1257325&avatarId=28409","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=JIRAUSER1257325&avatarId=28409","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=JIRAUSER1257325&avatarId=28409"},"displayName":"Alex Podelko","active":false,"timeZone":"UTC"},"created":"2022-01-12T23:07:31.000+0000","updated":"2022-01-12T23:07:31.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/1915961/comment/4289867","id":"4289867","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=etienne.petrel%40mongodb.com","name":"etienne.petrel@mongodb.com","key":"JIRAUSER1258229","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=JIRAUSER1258229&avatarId=28582","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=JIRAUSER1258229&avatarId=28582","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=JIRAUSER1258229&avatarId=28582","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=JIRAUSER1258229&avatarId=28582"},"displayName":"Etienne Petrel","active":true,"timeZone":"Australia/Sydney"},"body":"[~alex.podelko], I agree with Monica, we don't expect any perf regression.\r\n\r\nI had a look at the [code changes|https://github.com/mongodb/mongo/commit/f18bb1e1c2d7bedeb3c08964e6a65bcc794e2a2a#diff-2a2a9edb62db2893dba74cb38034548828f058c27ca5d706753f91c98853e97cR1579] that should re-enable the prefix search option. However we need to be careful as I think the changes are not correct ([~louis.williams]), the option is called {{prefix_search}} and not {{prefix_key}}, see the definition [here|https://github.com/wiredtiger/wiredtiger/blame/develop/dist/api_data.py#L1349]. Please make sure the option is enabled with the correct name, an example can be seen [here|https://github.com/wiredtiger/wiredtiger/blob/develop/test/cppsuite/tests/search_near_03.cxx#L112]. Let us know if this helps.","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=etienne.petrel%40mongodb.com","name":"etienne.petrel@mongodb.com","key":"JIRAUSER1258229","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?ownerId=JIRAUSER1258229&avatarId=28582","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&ownerId=JIRAUSER1258229&avatarId=28582","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&ownerId=JIRAUSER1258229&avatarId=28582","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&ownerId=JIRAUSER1258229&avatarId=28582"},"displayName":"Etienne Petrel","active":true,"timeZone":"Australia/Sydney"},"created":"2022-01-13T00:13:09.000+0000","updated":"2022-01-13T00:30:54.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/1915961/comment/4290315","id":"4290315","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=louis.williams%40mongodb.com","name":"louis.williams@mongodb.com","key":"louis.williams","avatar