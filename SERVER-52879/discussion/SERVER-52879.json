ersion/29771","id":"29771","name":"4.2.10","archived":false,"released":true,"releaseDate":"2020-09-30"},{"self":"https://jira.mongodb.org/rest/api/2/version/29812","id":"29812","name":"4.0.21","archived":false,"released":true,"releaseDate":"2020-10-29"},{"self":"https://jira.mongodb.org/rest/api/2/version/29981","id":"29981","name":"3.6.21","archived":false,"released":true,"releaseDate":"2020-11-13"}],"resolutiondate":"2021-01-07T19:08:33.000+0000","comment":{"comments":[{"self":"https://jira.mongodb.org/rest/api/2/issue/1543092/comment/3491722","id":"3491722","author":{"self":"https://jira.mongodb.org/rest/api/2/user?username=bruce.lucas%40mongodb.com","name":"bruce.lucas@mongodb.com","key":"bruce.lucas@10gen.com","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=10122","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=10122","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=10122","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=10122"},"displayName":"Bruce Lucas","active":false,"timeZone":"America/New_York"},"body":"Would it be possible to identify and remove the idle sessions from the cache under mutex, and then close those sessions outside of the mutex?","updateAuthor":{"self":"https://jira.mongodb.org/rest/api/2/user?username=bruce.lucas%40mongodb.com","name":"bruce.lucas@mongodb.com","key":"bruce.lucas@10gen.com","avatarUrls":{"48x48":"https://jira.mongodb.org/secure/useravatar?avatarId=10122","24x24":"https://jira.mongodb.org/secure/useravatar?size=small&avatarId=10122","16x16":"https://jira.mongodb.org/secure/useravatar?size=xsmall&avatarId=10122","32x32":"https://jira.mongodb.org/secure/useravatar?size=medium&avatarId=10122"},"displayName":"Bruce Lucas","active":false,"timeZone":"America/New_York"},"created":"2020-11-16T15:30:01.000+0000","updated":"2020-11-16T15:30:01.000+0000"},{"self":"https://jira.mongodb.org/rest/api/2/issue/1543092/comment/3492480","id":"349